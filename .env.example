# ==============================================================================
# Enterprise Dental WhatsApp Intelligence Platform — Environment Configuration
# ==============================================================================
# Copy this template to .env and provide your secret credentials.
# NEVER commit .env to version control.
# ==============================================================================

# --- Google Gemini AI API Configuration ---
# Required for AI practice qualification, battlecard generation, and call simulation
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# --- Authentication & Enterprise Access Control ---
# Set REQUIRE_AUTH=true to enforce password/PIN authentication on web dashboard and APIs.
# Default is false for friction-free local development.
REQUIRE_AUTH=false

# Master administrative password or PIN for rep access (used when REQUIRE_AUTH=true)
AUTH_PASSWORD=change_this_to_a_strong_password_in_production
AUTH_SECRET_KEY=change_this_to_a_random_64_character_hex_string_for_session_signing

# Session expiration in hours (default: 24)
AUTH_SESSION_HOURS=24

# --- Environment Mode ---
# Options: development, production, test
ENVIRONMENT=development

# Set to true to enforce strict validation that all required API keys are configured at startup
STRICT_SECRETS=false

# --- Headless Browser & Playwright ---
# Set to true to enable automated full-page screenshots of dental clinic websites
ENABLE_SCREENSHOTS=true
PLAYWRIGHT_HEADLESS=true

# --- Autonomous Territory Daemon ---
# Controls the background scheduling interval in hours
DAEMON_INTERVAL_HOURS=6.0
DAEMON_LIMIT_PER_CITY=8
